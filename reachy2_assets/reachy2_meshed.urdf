			<update_rate>30</update_rate>
			<camera name="depth_cam_l">
				<horizontal_fov>1.5707963267948966</horizontal_fov>
				<image>
					<width>1280</width>
					<height>720</height>
					<format>B8G8R8</format>
				</image>
				<distortion>
					<k1>0.006059</k1>
					<k2>-0.048786</k2>
					<k3>0.033282</k3>
					<p1>-0.000877</p1>
					<p2>-0.000732</p2>
					<center>0.5 0.5</center>
				</distortion>
				<noise>
					<type>gaussian</type>
					<mean>0.0</mean>
					<stddev>0.007</stddev>
				</noise>
			</camera>
			<plugin filename="libgazebo_ros_camera.so" name="depth_left_camera_controller">
				<ros>
					<namespace>camera</namespace>
					<remapping>left/image_raw:=/camera/left/color/image_raw</remapping>
					<remapping>left/image_raw/compressed:=/camera/left/color/image_raw/compressed</remapping>
					<remapping>left/camera_info:=/camera/left/color/camera_info</remapping>
				</ros>
